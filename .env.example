# AstroMatch (astro-love) — environment variables
# Copy to .env.local for dev, and set these in the Railway service for prod.

# ── Required in production (the server throws at boot if unset) ──────────────
# Stable, shared HMAC secret for entitlement tokens. Must be identical across
# every instance and survive restarts, or paid users lose access. Generate:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENTITLEMENT_SECRET=

# Secret for encrypting PII-safe share tokens (?s=). Falls back to
# ENTITLEMENT_SECRET if unset; set explicitly to rotate share links
# independently. Same generation command as above.
SHARE_SECRET=

# ── Required for the AI reading layer (absent → deterministic templates) ────
# Without this, /api/reading serves the template copy and proseAvailable=false;
# the app still works, just without per-couple AI prose.
ANTHROPIC_API_KEY=

# ── Optional ────────────────────────────────────────────────────────────────
# Writer model (default claude-opus-4-8) and the faithfulness checker
# (default claude-haiku-4-5; set to "" to disable the check).
WRITER_MODEL=claude-opus-4-8
FAITHFULNESS_MODEL=claude-haiku-4-5

# Entitlement token lifetime in ms (default 180 days).
# ENTITLEMENT_MAX_AGE_MS=15552000000

# Absolute site origin, used to resolve OG image URLs in link previews.
SITE_URL=https://astromatch.carecompass.me

# Payment verification (CareCompass). The verify URL defaults to the live
# endpoint; the expected amount/currency/product are enforced fail-closed.
# CARECOMPASS_VERIFY_URL=https://pay.carecompass.me/api/status
# CARECOMPASS_VERIFY_TOKEN=
# CARECOMPASS_EXPECT_AMOUNT=200
# CARECOMPASS_EXPECT_CURRENCY=USD
# CARECOMPASS_EXPECT_PRODUCT=astromatch

# Local testing only — grants entitlement WITHOUT a real payment. Never set
# this in production.
# ALLOW_TEST_UNLOCK=1
